<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="380" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <TextBlock Text="Display name shown to collaborators" FontSize="20"
                   Foreground="Black" TextWrapping="NoWrap" />
        <TextBox x:Name="NameInput" Grid.Row="1" FontSize="20"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="2" Content="Save" Width="72" Height="24"
                Command="{Binding SaveCommand}" />
    </Grid>
</UserControl>
