<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="360" Height="120" Spacing="8" Background="White">
        <TextBlock Text="Account notification preferences" FontSize="20"
                   Foreground="Black" Height="24" TextWrapping="NoWrap" />
        <TextBox Text="{Binding AccountName, Mode=TwoWay}" Height="28" />
        <Button Content="&#xE74E;" FontFamily="Segoe Fluent Icons"
                Command="{Binding SaveCommand}" />
    </StackPanel>
</UserControl>
