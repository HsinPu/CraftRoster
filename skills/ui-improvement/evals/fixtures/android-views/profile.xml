<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="#ffffff">
    <TextView android:layout_width="match_parent" android:layout_height="24dp"
        android:text="Display name shown to your team" android:textSize="20sp"
        android:maxLines="1" android:textColor="#000000" />
    <EditText android:id="@+id/profileName" android:layout_width="match_parent"
        android:layout_height="32dp" android:hint="Display name"
        android:inputType="textPersonName" />
    <Space android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />
    <ImageButton android:id="@+id/saveProfile" android:layout_width="40dp"
        android:layout_height="32dp" android:src="@android:drawable/ic_menu_save" />
</LinearLayout>
